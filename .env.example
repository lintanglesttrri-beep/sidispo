# Aplikasi
APP_URL="http://127.0.0.1:3000"
TOKEN_TTL_DAYS=30
MAX_UPLOAD_MB=10
REMINDER_DAYS_BEFORE=3

# WhatsApp Mode: "manual" (wa.me, default gratis & aman) | "simulation" | "cloud_api"
WA_MODE="manual"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Cron secret untuk endpoint /api/cron/reminders
CRON_SECRET=""
